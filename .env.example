# LUMINI — Variables de Entorno
# Copia este archivo como .env y completa los valores.

# Obligatorio: Clave para firmar cookies de sesión.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me

# Obligatorio: Contraseña del panel de administración (/admin)
ADMIN_PASSWORD=change_me

# SendGrid API key para envío de correos (boletines, notificaciones)
# Déjalo vacío para deshabilitar el envío de correos
SENDGRID_API_KEY=

# Dirección remitente para correos salientes
EMAIL_ORIGEN=lumini@example.com

# Entorno: production o development
FLASK_ENV=production

# Puerto del servidor HTTP
PORT=8000
